# Copiar a .env y llenar con valores reales. NUNCA subir .env a git.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
DATABASE_URL=

# Cadena larga y aleatoria. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Supabase → Project Settings → API
# Solo hasta .supabase.co (sin /rest/v1/). Ej: https://abcdefghijkl.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
