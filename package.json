{
  "name": "colectivos-del-cafe",
  "version": "0.1.0",
  "private": true,
  "description": "Registro contable de busetas de transporte intermunicipal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm install --prefix server && npm install --prefix frontend",
    "dev": "netlify dev",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix server",
    "lint": "npm run lint --prefix frontend",
    "migrar": "npm run migrar --prefix server",
    "crear-admin": "npm run crear-admin --prefix server --",
    "restablecer-password": "npm run restablecer-password --prefix server --",
    "crear-buckets": "npm run crear-buckets --prefix server"
  },
  "dependencies": {
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^27.14.1"
  }
}
